# Yalnızca yerel örnek; gerçek sırlar bu dosyaya yazılmaz. .env.local'a kopyalayın.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://uludott:replace-local-db-password@localhost:5432/uludott
# PostgreSQL yerel konteyneri (DATABASE_URL parolasıyla eşleşmeli)
LOCAL_POSTGRES_PASSWORD=replace-local-db-password
# S3 uyumlu yerel depo
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=garage
OBJECT_STORAGE_BUCKET=uludott-media
OBJECT_STORAGE_ACCESS_KEY=GK00000000000000000000000000000000
OBJECT_STORAGE_SECRET_KEY=replace-local-storage-password
# Wallet, bot ve e-posta entegrasyonları ilgili görevlerde ayrı eklenir.

# Yönetici MFA şifrelemesi ve CSRF için: openssl rand -hex 32 (64 hex karakter)
AUTH_ENCRYPTION_KEY=replace-with-random-64-hex-key

# Google Wallet: varsayılan kapalı; gerçek dosya depo DIŞINDA,0600 izinli.
GOOGLE_WALLET_MODE=disabled
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CREDENTIALS_FILE=
