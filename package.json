{
  "name": "uludott-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "11.19.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "start": "next start --hostname 127.0.0.1",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "build": "next build",
    "db:migrate": "node --env-file-if-exists=.env.local --conditions=react-server scripts/migrate.ts",
    "config:check": "node --env-file-if-exists=.env.local --conditions=react-server --experimental-strip-types scripts/check-config.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "admin:bootstrap": "node --env-file-if-exists=.env.local --conditions=react-server scripts/admin-bootstrap.ts",
    "db:seed:2026": "node --env-file-if-exists=.env.local --conditions=react-server scripts/seed-2026.ts",
    "db:seed:ulujam": "node --env-file-if-exists=.env.local --conditions=react-server scripts/seed-ulujam-years.ts",
    "submissions:purge": "node --env-file-if-exists=.env.local --conditions=react-server scripts/purge-submissions.ts",
    "worker": "node --env-file-if-exists=.env.local --conditions=react-server src/worker/main.ts",
    "security:wallet": "node --env-file-if-exists=.env.local --conditions=react-server scripts/check-wallet-package.ts",
    "security:source": "node --env-file-if-exists=.env.local scripts/check-secrets.ts",
    "ci:check": "bash scripts/ci-check.sh",
    "test:load": "bash scripts/run-load.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@node-rs/argon2": "2.2.1",
    "drizzle-orm": "0.45.3",
    "exceljs": "4.4.0",
    "libheif-js": "1.23.2",
    "next": "16.3.8",
    "otpauth": "9.5.2",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "jsqr": "1.4.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
